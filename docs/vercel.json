{
  "cleanUrls": true,
  "trailingSlash": true,
  "redirects": [
    { "source": "/:path*", "has": [{ "type": "host", "value": "www.zalgoart.com" }], "destination": "https://zalgoart.com/:path*", "permanent": true }
  ],
  "headers": [
    { "source": "/(.*)", "headers": [
      { "key": "X-Content-Type-Options", "value": "nosniff" },
      { "key": "Referrer-Policy", "value": "strict-origin-when-cross-origin" }
    ] },
    { "source": "/demo/(.*)", "headers": [{ "key": "Cache-Control", "value": "public, max-age=604800" }] },
    { "source": "/favicon.ico", "headers": [{ "key": "Cache-Control", "value": "public, max-age=86400" }] },
    { "source": "/favicon.svg", "headers": [{ "key": "Cache-Control", "value": "public, max-age=86400" }] },
    { "source": "/favicon-96x96.png", "headers": [{ "key": "Cache-Control", "value": "public, max-age=86400" }] },
    { "source": "/apple-touch-icon.png", "headers": [{ "key": "Cache-Control", "value": "public, max-age=86400" }] },
    { "source": "/icon-192.png", "headers": [{ "key": "Cache-Control", "value": "public, max-age=86400" }] },
    { "source": "/icon-512.png", "headers": [{ "key": "Cache-Control", "value": "public, max-age=86400" }] },
    { "source": "/og.png", "headers": [{ "key": "Cache-Control", "value": "public, max-age=86400" }] },
    { "source": "/site.webmanifest", "headers": [{ "key": "Cache-Control", "value": "public, max-age=86400" }] }
  ]
}
